{
  "name": "@centinel/server",
  "version": "0.1.0",
  "private": true,
  "description": "Centinel runtime server — owns the five agent roles, internal cron, and the HTTP/SSE surface. Built on @mariozechner/pi-coding-agent.",
  "type": "module",
  "bin": {
    "centinel": "dist/cli.js",
    "centinel-server": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js dist/server.js",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "croner": "^9.0.0",
    "typebox": "^1.1.38",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
