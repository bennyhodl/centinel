[Unit]
Description=Centinel web app (Next.js)
Documentation=https://github.com/bennyhodl/centinel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/code/centinel/app
EnvironmentFile=-%h/code/centinel/.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PORT=3000
# %%PNPM_PATH%% is replaced at install time by `centinel install-services`
# with the absolute path to pnpm (resolved from $PATH or nvm/corepack).
ExecStart=%%PNPM_PATH%% start
Restart=on-failure
RestartSec=5
# Tail logs with: journalctl --user -u centinel-web -f

[Install]
WantedBy=default.target
