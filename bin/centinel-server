#!/usr/bin/env bash
# centinel-server — boot the runtime server in the foreground.
#
# Equivalent to: bin/centinel server start
# Phase 0: forwards to server/dist/server.js.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERVER_JS="$REPO_ROOT/server/dist/server.js"

if [ ! -f "$SERVER_JS" ]; then
    echo "[centinel-server] server/dist/server.js not found — building…" >&2
    (cd "$REPO_ROOT" && pnpm --filter @centinel/server build >&2)
fi

exec node "$SERVER_JS" "$@"
