#!/usr/bin/env bash
# Centinel CLI — entry point for operator commands.
#
# Phase 0: forwards to the TypeScript CLI under server/dist/cli.js.
# Build first if dist is missing.
#
# See docs/PI_MIGRATION_PLAN.md.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLI_JS="$REPO_ROOT/server/dist/cli.js"

if [ ! -f "$CLI_JS" ]; then
    echo "[centinel] server/dist/cli.js not found — building…" >&2
    (cd "$REPO_ROOT" && pnpm --filter @centinel/server build >&2)
fi

exec node "$CLI_JS" "$@"
