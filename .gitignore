# Root-level ignores for the monorepo.
# App-specific ignores live in app/.gitignore — these are extra defense-in-depth.

# dependencies — anywhere in the tree
**/node_modules/
**/.pnp/
**/.pnp.*

# build artifacts
**/.next/
**/.turbo/
**/out/
**/build/
**/coverage/

# os / editor
.DS_Store
*.pem
*.log
.idea/
.vscode/
*.swp
*~

# env (covered per-package, but defense-in-depth)
.env
.env.local
.env.*.local

# typescript
**/*.tsbuildinfo
**/next-env.d.ts
wiki
.pnpm-store
lib/__pycache__/
