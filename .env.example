# Centinel runtime secrets — never commit this file.
# Copy to .env and fill in.

# ─── Web app ───────────────────────────────────────────────────────────────
# Shared password for the basic-auth gate that protects every web route.
CENTINEL_PASSWORD=

# Override the wiki path (otherwise read from doge.config.yaml).
# CENTINEL_WIKI_PATH=~/wiki/Tampa

# Path to the Editor persona markdown loaded into /chat's system prompt.
# CENTINEL_EDITOR_PERSONA_PATH=~/code/centinel/docs/EDITOR_PERSONA.md

# ─── Hermes endpoint ───────────────────────────────────────────────────────
# OpenAI-compatible base URL for /chat (the Editor persona). If you run Hermes
# locally, default is http://localhost:8000/v1.
HERMES_API_URL=http://localhost:8000/v1
HERMES_API_KEY=
# Optional: override the default model the chat route uses.
# HERMES_MODEL=gpt-4o

# ─── Datasette (optional) ──────────────────────────────────────────────────
# DATASETTE_URL=http://localhost:8001

# ─── Tavily Crawl ──────────────────────────────────────────────────────────
# REQUIRED for sitemap-builder bootstrap/lint/subtree modes.
# Free tier: 1000 credits/mo (~10K pages). Sign up: https://tavily.com
# Without this key, the sitemap-builder skill cannot crawl — but the rest
# of Centinel still runs (Editor chat, web app, manual investigations).
TAVILY_API_KEY=
