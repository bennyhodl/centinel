# Centinel runtime secrets — never commit this file.
# Copy to .env and fill in.

# ─── Web app ───────────────────────────────────────────────────────────────
# Shared password for the basic-auth gate that protects every web route.
CENTINEL_PASSWORD=

# Override the wiki path (otherwise read from doge.config.yaml).
# CENTINEL_WIKI_PATH=~/wiki/Tampa

# Path to the Editor persona markdown loaded into /chat's system prompt.
# CENTINEL_EDITOR_PERSONA_PATH=~/code/centinel/docs/EDITOR_PERSONA.md

# ─── Hermes endpoint ───────────────────────────────────────────────────────
# OpenAI-compatible base URL for /chat (the Editor persona).
#
# Use `http://host.docker.internal:<PORT>/v1` when the web app runs in Docker
# (the default — host.docker.internal is wired in docker-compose.yml). Use
# `http://localhost:<PORT>/v1` only if you run the web app directly on the
# host with `pnpm dev`.
#
# <PORT> must match API_SERVER_PORT exported when starting the Hermes gateway
# (see Hermes api_server docs — defaults to 8642 if unset).
HERMES_API_URL=http://host.docker.internal:8000/v1
HERMES_API_KEY=
# Optional: override the default model the chat route uses.
# HERMES_MODEL=gpt-4o

# ─── Datasette (read-only DB browser) ──────────────────────────────────────
# Datasette runs in docker-compose at port 8001. Override via DATASETTE_URL
# only if you're running a separate instance.
# DATASETTE_URL=http://localhost:8001

# ─── Docker compose ────────────────────────────────────────────────────────
# Required when running `docker compose up`. Hermes lives on the host;
# the web container mounts ~/.hermes config and the hermes binary.

# Absolute path to the `hermes` binary on your host machine.
# Find with: which hermes
# HERMES_BIN_PATH=/home/you/.local/bin/hermes

# Override Hermes config dir if you don't use the default ~/.hermes.
# HERMES_CONFIG_PATH=/home/you/.hermes

# City slug — Datasette serves <wiki>/_data/<CITY_SLUG>.db. Defaults to "tampa".
# Must match the slug in doge.config.yaml.
# CITY_SLUG=tampa

# ─── Tavily Crawl ──────────────────────────────────────────────────────────
# REQUIRED for sitemap-builder bootstrap/lint/subtree modes.
# Free tier: 1000 credits/mo (~10K pages). Sign up: https://tavily.com
# Without this key, the sitemap-builder skill cannot crawl — but the rest
# of Centinel still runs (Editor chat, web app, manual investigations).
TAVILY_API_KEY=
