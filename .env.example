# Centinel runtime secrets — never commit this file.
# Copy to .env and fill in.
#
# This file is read by:
#   - bin/centinel (the host CLI / dispatcher)
#   - centinel-web.service (Next.js, via EnvironmentFile=)
#   - centinel-datasette.service (Datasette, via EnvironmentFile=)

# ─── Web app ───────────────────────────────────────────────────────────────
# Shared password for the basic-auth gate that protects every web route.
CENTINEL_PASSWORD=

# Override the wiki path (otherwise read from doge.config.yaml).
# Use an absolute host path. Tildes are expanded.
# CENTINEL_WIKI_PATH=/home/ec2-user/wiki/Tampa

# Path to the Editor persona markdown loaded into /chat's system prompt.
# CENTINEL_EDITOR_PERSONA_PATH=/home/ec2-user/code/centinel/docs/EDITOR_PERSONA.md

# ─── Hermes endpoint ───────────────────────────────────────────────────────
# Hermes runs on the same host (no Docker), so localhost is fine.
# <PORT> must match API_SERVER_PORT exported when starting the Hermes gateway
# (defaults to 8642 if unset).
HERMES_API_URL=http://127.0.0.1:8000/v1
HERMES_API_KEY=

# Optional: override the default model the chat route uses.
# HERMES_MODEL=gpt-4o

# ─── Datasette (read-only DB browser) ──────────────────────────────────────
# Datasette runs as a host systemd unit on 127.0.0.1:8001. The web app proxies
# it at /datasette/. Override only if you're running a separate instance.
# DATASETTE_URL=http://127.0.0.1:8001
# DATASETTE_INTERNAL_URL=http://127.0.0.1:8001

# Optional: override the city slug used to find {wiki}/_data/<slug>.db.
# CITY_SLUG=tampa

# ─── External APIs ─────────────────────────────────────────────────────────
# Tavily for sitemap-builder skill.
TAVILY_API_KEY=
