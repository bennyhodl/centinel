# Centinel configuration.
#
# `centinel run` walks every [[source]] below: discover, collect, extract, index, then
# one corpus-wide embed. Every stage skips work it has already done, so running it twice
# is cheap and running it from cron is the intended use.

# Where the store lives. Defaults to ~/.centinel, so every run collects into one corpus
# whatever directory it was started from. `--root` and $CENTINEL_ROOT override it.
#   root = "~/.centinel"

[defaults]
# Requests per second, per host. Deliberately slow.
rps = 1.0
lang = "en"

# The servers that embed, rerank and transcribe. Centinel runs no model itself: each is a
# request to the server named here. Every capability uses `base_url` unless its own table
# names another. A server on this machine keeps everything here; one elsewhere receives
# chunk text, queries and audio.
[inference]
base_url = "http://127.0.0.1:8080/v1"
# For a server that wants a key: the name of the variable holding it, never the key.
#   api_key_env = "OPENROUTER_API_KEY"

[inference.embed]
model = "qwen3-embedding-4b"
# Qwen3-Embedding wants queries wrapped like this and documents bare. A symmetric model
# (OpenAI's) wants "". Changing the model is a new vector space.
query_prefix = "Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:"
# Chunks per request, and requests in flight.
batch = 64
concurrency = 4

[inference.rerank]
model = "qwen3-reranker-0.6b"
#   base_url = "http://127.0.0.1:8081/v1"

[inference.transcribe]
model = "whisper-large-v3-turbo"
#   base_url = "http://127.0.0.1:8178/v1"

# A website. `site` is any URL on it; only the origin is used.
#   [[source]]
#   id = "tampa"
#   site = "https://www.tampa.gov"

# A YouTube channel — a peer of a website, differing only in how it is acquired.
#   [[source]]
#   id = "tampa-council"
#   channel = "https://www.youtube.com/@CityofTampa"
#   audio_if_no_captions = true

[open]
# Either an application name, or a command template containing {path}.
#   pdf      = "Adobe Acrobat"
#   markdown = "Obsidian"
#   html     = "Safari"
#   text     = "nvim {path}"
#
# "system" hands the file to the OS default handler.
default = "system"
