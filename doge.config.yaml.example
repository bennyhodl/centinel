# Centinel — per-city configuration. Commit this to your fork.
# Secrets go in .env, NOT here.

city:
  name: Tampa
  slug: tampa
  domain: tampa.gov
  timezone: America/New_York

wiki:
  # Operator's wiki root. ~ and $VARS are expanded.
  path: ~/wiki/Tampa

watch_presets:
  - errant-spending
  - corruption-signals
  # - policy-drift  # disabled by default

# Override the default cron schedules per role. Leave commented to use defaults.
cron_schedule_overrides:
  # sitemap_lint:      "0 3 * * 1"
  # watch_runner:      "0 4 * * *"
  # data_reporter:     "0 */6 * * *"
  # vault_manifest:    "*/15 * * * *"
  # huddle_rollup:     "0 18 * * *"
  # briefings:         "0 9 * * 1"
  # investigator_tick: "0 */4 * * *"

# Investigation slugs to suppress from public /status (e.g. active corruption probe with right-of-reply pending).
confidential_investigations: []
